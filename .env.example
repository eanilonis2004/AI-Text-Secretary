# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# --- Required ---

# Shared secret your iOS Shortcut sends as the x-auth-token header.
# Any long random string works -- generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_TOKEN=

# Groq API key (https://console.groq.com) used for AI message parsing.
GROQ_API_KEY=

# Google OAuth token JSON for Calendar access. This is the full JSON blob
# produced after completing the Google OAuth flow for a project with the
# Calendar API enabled (needs an access_token, refresh_token, client_id,
# client_secret, and token_uri at minimum).
GOOGLE_TOKEN={"token": "...", "refresh_token": "...", "client_id": "...", "client_secret": "...", "token_uri": "https://oauth2.googleapis.com/token"}

# --- Optional ---
# IANA timezone name for interpreting and displaying event times.
# Defaults to America/New_York if not set.
TIMEZONE=America/New_York
# What to call yourself in calendar events/notifications when the sender
# field matches your own outgoing message (e.g. texting yourself a
# reminder). Defaults to "Me" if not set.
SELF_NAME=Me

# Gmail SMTP credentials for the weekly digest email. Both must be set
# for digest emails to actually send -- if either is missing, the /digest
# endpoint just skips emailing and still returns the notification text.
# SMTP_APP_PASSWORD must be a Gmail "App Password", not your normal
# account password (generate one under Google Account > Security).
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# Where digest emails get sent. Defaults to SMTP_EMAIL if not set.
DIGEST_EMAIL_TO=
